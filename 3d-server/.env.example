# Kopieren nach .env und ausfuellen. .env NIEMALS ins Git-Repo!

# --- Betrieb ---
DEMO_MODE=0                 # 1 = ohne Meshy/Blender/Claude testen (erzeugt eine Demo-Vase)
DATA_DIR=./data
JOB_WORKERS=1               # 1 reicht und schont den PC (Minecraft-Server laeuft daneben)
BLENDER_PARALLEL=1
JOB_TTL_HOURS=24            # Dateien werden danach geloescht
JOBS_PER_IP_PER_DAY=10      # pro Besucher
JOBS_TOTAL_PER_DAY=40       # alle Besucher zusammen: schuetzt Meshy-Guthaben und Claude-Kontingent
ACCESS_CODE=                # optional: Zugangscode, den Besucher eingeben muessen
ALLOWED_ORIGINS=https://erschoenfeld2-tech.github.io
CLIENT_IP_HEADER=cf-connecting-ip   # Cloudflare Tunnel; bei Tailscale Funnel: x-forwarded-for
SERVE_FRONTEND=1            # liefert site/ unter /3d/ mit aus (zum Testen ohne GitHub Pages)

# --- Meshy (3D-Erzeugung) ---
MESHY_API_KEY=
MESHY_AI_MODEL=meshy-6
MESHY_POLYCOUNT=100000

# --- Claude (nur fuer Text-Beschreibungen) ---
# auto = API-Key, wenn gesetzt, sonst das lokal angemeldete Claude Code (wie der KI-Bot)
CLAUDE_BACKEND=auto
# Lokales Claude Code (claude.exe der Claude-App); Pfad nur setzen, wenn er nicht gefunden wird
CLAUDE_CLI_MODEL=claude-haiku-5-5
CLAUDE_EXE=
# API-Key (eigenes Budget, Ausgabenlimit in der Claude Console setzen)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# Noch sparsamer mit API-Key (ca. 40x billiger, fuer diese einfache Aufgabe meist ausreichend):
# CLAUDE_MODEL=claude-haiku-5-5

# --- Blender ---
BLENDER_MODE=cli            # cli = ohne Oberflaeche, mcp = laufendes Blender mit blender-mcp-Addon
BLENDER_BIN='C:\Program Files\Blender Foundation\Blender 4.5\blender.exe'
BLENDER_THREADS=4           # Kerne fuer Blender begrenzen, damit Minecraft fluessig bleibt
BLENDER_LOW_PRIORITY=1      # Blender mit niedriger Prioritaet starten
BLENDER_MCP_PORT=9876
BLENDER_TIMEOUT=900
