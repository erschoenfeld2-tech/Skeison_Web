# Kopieren nach .env und ausfuellen. .env NIEMALS ins Git-Repo!
# Die .env gilt vor Umgebungsvariablen (Ausnahme: WORKER_TAKEOVER, wenn es einmalig in der Shell gesetzt wird).
# Hinter ein '=' ohne Wert NIE einen Kommentar auf dieselbe Zeile schreiben: der Kommentar wuerde zum Wert.

# --- Betrieb ---
# Name dieses Server-PCs: HW_01 oder HW_02 (leer = Computername). Pro PC ANDERS, sonst greift die Umzugs-Sperre nicht.
SERVER_NAME=
DEMO_MODE=0                 # 1 = ohne Claude/Meshy/Blender testen (erzeugt eine Demo-Vase)
DATA_DIR=./data
# S3D_PORT=8095            # nur wenn 8095 auf diesem PC belegt ist: Sperre gegen doppelten Start (nimmt nichts an), 8090 ist das Admin-Panel
JOB_WORKERS=1               # 1 reicht und schont den PC (Minecraft-Server laeuft daneben)
BLENDER_PARALLEL=1
JOB_TTL_HOURS=24            # Dateien werden danach geloescht
JOBS_PER_IP_PER_DAY=3       # pro Besucher
JOBS_TOTAL_PER_DAY=10       # alle Besucher zusammen: schont das Claude-Abo (der KI-Bot nutzt es mit)
# Zugangscode, den Besucher eingeben muessen (leer = kein Code, jeder darf Auftraege anlegen)
ACCESS_CODE=

# --- Wie entsteht das Modell? ---
# claude = Claude modelliert selbst in Blender (nur Claude-Abo, kein weiteres Geld)
# meshy  = KI-Generator Meshy (braucht MESHY_API_KEY, Pro-Abo bei Meshy, kostet Credits)
# auto   = meshy, wenn ein Key eingetragen ist, sonst claude
GENERATOR=claude
CAD_MAX_CALLS=4             # Claude-Aufrufe pro Auftrag (Entwurf + bis zu 3 Kontrollen mit Vorschaubild)
CLAUDE_CAD_TIMEOUT=300      # Sekunden pro Claude-Aufruf beim Modellieren

# --- Supabase (worker.py auf dem Server-PC) ---
# Auf einem frisch geklonten PC (z. B. HW_02) gibt es keine admin.config.json: URL und service_role-Key kommen HIER hinein.
# Die URL ist oeffentlich (steht in site/wunschliste/api.js). Den service_role-Key nie ins Repo und nie in Chats/Logs!
SUPABASE_URL=https://pumdupjmmvimlxqvuymg.supabase.co
SUPABASE_SERVICE_KEY=
# Nur Rueckfall, wenn URL oder Key oben leer sind (alter Server-PC mit Admin-Panel): Datei mit supabaseUrl und serviceKey
# SUPABASE_ADMIN_CONFIG=C:\MinecraftHosting\tools\admin.config.json
POLL_SECONDS=4              # so oft fragt der Worker nach neuen Auftraegen
WORKER_TAKEOVER=0           # 1 = starten, obwohl ein anderer Server-PC noch Lebenszeichen sendet (nur beim Umzug)

# --- Claude ---
# cli = das lokal angemeldete Claude Code (wie der KI-Bot), zaehlt gegen das Abo, kein zusaetzliches Geld
# api = API-Key (kostet Geld)   off = nie aufrufen
CLAUDE_BACKEND=cli
CLAUDE_CAD_MODEL=sonnet     # Modellieren (Alias fuer das aktuelle Sonnet im Abo)
CLAUDE_CLI_MODEL=claude-haiku-5-5   # nur fuer Meshy-Prompts
CLAUDE_CLI_TIMEOUT=120      # Sekunden pro Claude-Aufruf (Meshy-Prompts)
# Pfad zu claude.exe, nur setzen, wenn er nicht gefunden wird
CLAUDE_EXE=
# LEER LASSEN (und keinen Kommentar hinter das = schreiben), sonst nutzt claude.exe den Key statt des Abos und es kostet Geld.
# Nur mit CLAUDE_BACKEND=api.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- Meshy (nur GENERATOR=meshy) ---
MESHY_API_KEY=
MESHY_AI_MODEL=meshy-6
MESHY_POLYCOUNT=100000

# --- Blender ---
BLENDER_MODE=cli            # cli = ohne Oberflaeche, mcp = laufendes Blender mit blender-mcp-Addon (nur printprep)
BLENDER_BIN='C:\Program Files\Blender Foundation\Blender 4.5\blender.exe'
BLENDER_THREADS=4           # Kerne fuer Blender begrenzen, damit Minecraft fluessig bleibt
BLENDER_LOW_PRIORITY=1      # Blender mit niedriger Prioritaet starten
BLENDER_MAX_RAM_MB=3072     # Blender wird beendet, bevor es Minecraft den Speicher nimmt (nur Windows)
BLENDER_MCP_PORT=9876
BLENDER_TIMEOUT=900
BLENDER_CAD_TIMEOUT=180     # Zeitlimit fuer Claudes Modellier-Skript
# Vorschaubilder fuer Claudes Kontrolle:
#   cycles    = Rendern auf der CPU (Standard). Braucht keinen OpenGL-Kontext, laeuft auch in einer getrennten Windows-Sitzung
#   workbench = schneller, aber ohne angemeldeten Desktop stuerzt Blender hart ab (nicht abfangbar)
#   auto      = workbench, bei einem Renderfehler cycles (faengt den harten Absturz NICHT ab)
BLENDER_PREVIEW_ENGINE=cycles
BLENDER_PREVIEW_SAMPLES=24  # nur cycles: Samples je Ansicht (mehr = ruhigeres Bild, langsamer)
PRINT_MAX_TRIANGLES=0      # 0 = aus dem Detailgrad der Druckeinstellungen (Standard 150000, Fein 300000, Sehr fein 500000)

# --- Nur app.py (Direktbetrieb ueber HTTP, zum lokalen Testen) ---
ALLOWED_ORIGINS=https://erschoenfeld2-tech.github.io
CLIENT_IP_HEADER=x-forwarded-for
SERVE_FRONTEND=1            # liefert site/ unter /3d/ mit aus (zum Testen ohne GitHub Pages)
# SITE_DIR=                 # nur wenn site/ nicht neben 3d-server/ liegt
