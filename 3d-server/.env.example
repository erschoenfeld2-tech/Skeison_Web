# Kopieren nach .env und ausfuellen. .env NIEMALS ins Git-Repo!

# --- Betrieb ---
DEMO_MODE=0                 # 1 = ohne Meshy/Blender/Claude testen (erzeugt eine Demo-Vase)
DATA_DIR=./data
JOB_WORKERS=2
BLENDER_PARALLEL=1
JOB_TTL_HOURS=24            # Dateien werden danach geloescht
JOBS_PER_IP_PER_DAY=10      # schuetzt dein Meshy-Guthaben und Claude-Budget
ACCESS_CODE=                # optional: Zugangscode, den Besucher eingeben muessen
ALLOWED_ORIGINS=https://erschoenfeld2-tech.github.io

# --- Meshy (3D-Erzeugung) ---
MESHY_API_KEY=
MESHY_AI_MODEL=meshy-6
MESHY_POLYCOUNT=100000

# --- Claude (nur fuer Text-Beschreibungen) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# Noch sparsamer (ca. 40x billiger, fuer diese einfache Aufgabe meist ausreichend):
# CLAUDE_MODEL=claude-haiku-5-5

# --- Blender ---
BLENDER_MODE=cli            # cli = headless auf dem Server, mcp = laufendes Blender mit blender-mcp-Addon
BLENDER_BIN=/opt/blender/blender
BLENDER_MCP_PORT=9876
BLENDER_TIMEOUT=900
